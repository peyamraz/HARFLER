+import { describe, expect, it } from "vitest";
+import { GROUPS } from "../../src/game/letters";
+import { kayitlar, slug } from "../kayit-mantik";
+
+describe("kayıt dosyası adlandırması", () => {
+  it("İ ile I ayrı dosya alır (Windows büyük/küçük harf duyarlı değil)", () => {
+    // İkisi aynı dosyaya düşerse çocuk "ı" yerine "i" duyar — tam da
+    // daha önce yaşanan hatanın dosya düzeyindeki hâli.
+    expect(slug("İ")).toBe("i-noktali");
+    expect(slug("I")).toBe("i-noktasiz");
+    expect(slug("İ")).not.toBe(slug("I"));
+  });
+
+  it("hiçbir dosya adı iki farklı metne denk gelmez", () => {
+    const liste = kayitlar("hepsi");
+    const esleme = new Map<string, Set<string>>();
+    for (const k of liste) {
+      const once = esleme.get(k.dosya) ?? new Set<string>();
+      once.add(k.metin);
+      esleme.set(k.dosya, once);
+    }
+    const cakisan = [...esleme].filter(([, metinler]) => metinler.size > 1);
+    expect(cakisan, "aynı dosya birden çok metne verilmiş").toEqual([]);
+  });
+
+  it("29 harf sesinin hepsi listede ve dosya adı harften türetilir", () => {
+    const harfler = kayitlar("harf");
+    expect(harfler).toHaveLength(29);
+    for (const g of GROUPS) {
+      for (const l of g.letters) {
+        const bulundu = harfler.find(
+          (k) => k.metin === l.say && k.dosya === `harf-${slug(l.char)}.mp3`,
+        );
+        expect(bulundu, `${l.char} sesi "${l.say}" listede yok`).toBeTruthy();
+      }
+    }
+  });
+
+  it("dosya adları Windows güvenli: küçük harf, rakam, tire", () => {
+    for (const k of kayitlar("hepsi")) {
+      expect(k.dosya, k.metin).toMatch(/^[a-z0-9-]+\.mp3$/);
+    }
+  });
+});
diff --git a/scripts/kayit-al.ts b/scripts/kayit-al.ts
new file mode 100644
index 0000000..1f63d15
--- /dev/null
+++ b/scripts/kayit-al.ts
@@ -0,0 +1,163 @@
+/**
+ * Türkçe ses kayıtlarını ElevenLabs ile üretir ve ses bankasına bağlar.
+ *
+ * NEDEN BU BETİK VAR: harf sesleri (a, e, ne, te...) tek harflik/hecelik
+ * metinlerdir ve sıradan bir ses modeli bunları yanlış okur ("e" harfini
+ * İngilizce harf adı gibi /iː/ okuyup çocuğa "i" dedirtir). Bu yüzden kayıt
+ * üretimini Türkçeyi resmî olarak destekleyen ve dil kodu verilebilen bir
+ * servis yapar; dosyaları da İNSAN KULAĞIYLA dinleyip onaylarsın.
+ *
+ * ANAHTAR GÜVENLİĞİ: API anahtarı YALNIZCA ortam değişkeninden okunur; hiçbir
+ * dosyaya yazılmaz, ekrana basılmaz, commit edilmez.
+ *
+ * KULLANIM (proje kökünde):
+ *   macOS/Linux : export ELEVENLABS_API_KEY="..."
+ *   Windows cmd : set ELEVENLABS_API_KEY=...
+ *   PowerShell  : $env:ELEVENLABS_API_KEY="..."
+ *
+ *   npm run kayit -- --deneme               # TEK ses üret, önce kulağınla dinle
+ *   npm run kayit -- --sesleri-listele      # sesleri gör, bayan bir ses seç
+ *   npm run kayit -- --ses <voice_id> --sadece harf
+ *   npm run kayit -- --ses <voice_id> --sadece hepsi
+ *   npm run banka                           # yalnızca src/audio/ -> audioBank.ts
+ */
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { bankaYaz, MANIFEST, SES_KLASORU } from "./kayit-banka";
+import { kayitlar, slug, type Kayit, type Tur } from "./kayit-mantik";
+
+const API = "https://api.elevenlabs.io/v1/text-to-speech";
+const SESLER_API = "https://api.elevenlabs.io/v1/voices";
+/** Türkçe destekli ve dil kodu verilebilen model. */
+const VARSAYILAN_MODEL = "eleven_flash_v2_5";
+const VARSAYILAN_SES = "21m00Tcm4TlvDq8ikWAM";
+
+function anahtar(): string {
+  const k = process.env.ELEVENLABS_API_KEY;
+  if (!k) {
+    throw new Error(
+      [
+        "ELEVENLABS_API_KEY ortam değişkeni yok.",
+        "",
+        '  macOS/Linux : export ELEVENLABS_API_KEY="..."',
+        "  Windows cmd : set ELEVENLABS_API_KEY=...",
+        '  PowerShell  : $env:ELEVENLABS_API_KEY="..."',
+        "",
+        "Anahtarı sohbete YAZMA; kendi makinende ortam değişkeni olarak ver.",
+      ].join("\n"),
+    );
+  }
+  return k;
+}
+
+async function uret(k: string, ses: string, model: string, kayit: Kayit): Promise<void> {
+  const govde: Record<string, unknown> = {
+    text: kayit.metin,
+    model_id: model,
+    voice_settings: {
+      stability: 0.55,
+      similarity_boost: 0.8,
+      style: 0,
+      use_speaker_boost: true,
+    },
+  };
+  // Dil kodunu yalnızca kabul eden modellere gönder: eleven_multilingual_v2
+  // dili metinden kendi anlar, oraya göndermek uyarı üretir.
+  if (model !== "eleven_multilingual_v2") govde.language_code = "tr";
+
+  const yanit = await fetch(`${API}/${ses}`, {
+    method: "POST",
+    headers: { "xi-api-key": k, "Content-Type": "application/json", Accept: "audio/mpeg" },
+    body: JSON.stringify(govde),
+  });
+  if (!yanit.ok) {
+    const metin = await yanit.text().catch(() => "");
+    throw new Error(`"${kayit.metin}" üretilemedi (HTTP ${yanit.status}): ${metin.slice(0, 300)}`);
+  }
+  const bayt = Buffer.from(await yanit.arrayBuffer());
+  if (bayt.length < 500) {
+    throw new Error(`"${kayit.metin}" için boş/bozuk ses döndü (${bayt.length} bayt)`);
+  }
+  writeFileSync(join(SES_KLASORU, kayit.dosya), bayt);
+}
+
+async function sesleriListele(k: string): Promise<void> {
+  const yanit = await fetch(SESLER_API, { headers: { "xi-api-key": k } });
+  if (!yanit.ok) throw new Error(`Ses listesi alınamadı (HTTP ${yanit.status})`);
+  const veri = (await yanit.json()) as {
+    voices?: { voice_id: string; name: string; labels?: Record<string, string> }[];
+  };
+  console.log("\nvoice_id                            ad                       etiketler");
+  for (const v of veri.voices ?? []) {
+    const etiket = Object.entries(v.labels ?? {})
+      .map(([a, b]) => `${a}=${b}`)
+      .join(" ");
+    console.log(`${v.voice_id.padEnd(36)}${(v.name ?? "").slice(0, 24).padEnd(25)}${etiket}`);
+  }
+  console.log("\nBayan bir ses seç ve --ses <voice_id> ile kullan.\n");
+}
+
+async function main(): Promise<void> {
+  const arg = process.argv.slice(2);
+  const deger = (ad: string, yok: string) => {
+    const i = arg.indexOf(ad);
+    return i >= 0 && arg[i + 1] ? arg[i + 1] : yok;
+  };
+  const varMi = (ad: string) => arg.includes(ad);
+
+  if (varMi("--banka")) {
+    const n = bankaYaz();
+    console.log(`audioBank.ts yeniden yazıldı: ${n} kayıt.`);
+    console.log("Dinleyip doğrula: npm run dev");
+    console.log("Kapsam kilidini güncelle: src/game/__tests__/audioBank.test.ts");
+    return;
+  }
+
+  const k = anahtar();
+  if (varMi("--sesleri-listele")) return sesleriListele(k);
+
+  const ses = deger("--ses", VARSAYILAN_SES);
+  const model = deger("--model", VARSAYILAN_MODEL);
+  const sadece = deger("--sadece", "harf") as Tur | "hepsi";
+  const deneme = varMi("--deneme");
+  const atla = !varMi("--yeniden");
+
+  mkdirSync(SES_KLASORU, { recursive: true });
+  const liste: Kayit[] = deneme
+    ? [{ tur: "harf", metin: "e", dosya: `harf-${slug("E")}.mp3` }]
+    : kayitlar(sadece);
+
+  const manifest: Record<string, string> = existsSync(MANIFEST)
+    ? (JSON.parse(readFileSync(MANIFEST, "utf8")) as Record<string, string>)
+    : {};
+
+  console.log(`\nSes: ${ses}\nModel: ${model}  Dil: tr`);
+  console.log(`${liste.length} kayıt üretilecek.\n`);
+
+  let yapildi = 0;
+  for (const kayit of liste) {
+    const yol = join(SES_KLASORU, kayit.dosya);
+    if (atla && existsSync(yol)) {
+      manifest[kayit.dosya] = kayit.metin;
+      console.log(`= ${kayit.dosya}  (zaten var; --yeniden ile üzerine yaz)`);
+      continue;
+    }
+    await uret(k, ses, model, kayit);
+    manifest[kayit.dosya] = kayit.metin;
+    yapildi += 1;
+    console.log(`+ ${kayit.dosya}   "${kayit.metin}"`);
+  }
+
+  writeFileSync(MANIFEST, JSON.stringify(manifest, null, 2) + "\n");
+  const n = bankaYaz();
+  console.log(`\n${yapildi} yeni kayıt üretildi. Bankada toplam ${n} metin.`);
+  console.log("\nŞİMDİ DİNLE — doğrulanmamış ses yayına girmemeli:");
+  console.log("  npm run dev    (harf kutularına bas; özellikle a / e / i / ı)");
+  console.log("Yanlış olan dosyayı sil, sonra: npm run banka");
+  console.log("Kapsam kilidini güncelle: src/game/__tests__/audioBank.test.ts\n");
+}
+
+main().catch((e: unknown) => {
+  console.error(`\nHATA: ${e instanceof Error ? e.message : String(e)}\n`);
+  process.exit(1);
+});
diff --git a/scripts/kayit-banka.ts b/scripts/kayit-banka.ts
new file mode 100644
index 0000000..d3414ff
--- /dev/null
+++ b/scripts/kayit-banka.ts
@@ -0,0 +1,112 @@
+/**
+ * src/audio/ klasöründeki kayıtlardan src/game/audioBank.ts dosyasını üretir.
+ *
+ * Banka elle tutulmaz: diskte hangi ses dosyası varsa banka onu yansıtır.
+ * Böylece yanlış bir kaydı silmek, bankadan da düşürmek demek — arada
+ * "dosya yok ama banka onu gösteriyor" durumu kalmaz.
+ */
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+export const SES_KLASORU = "src/audio";
+/** audioBank.ts src/game/ içinde durur; oradan src/audio/ "​../audio" olur. */
+const IMPORT_ONEK = "../audio";
+export const MANIFEST = join(SES_KLASORU, "manifest.json");
+export const BANKA_DOSYASI = "src/game/audioBank.ts";
+
+const BASLIK = `/**
+ * Önceden kaydedilmiş sesler: konuşulacak metin -> ses dosyası.
+ *
+ * BU DOSYA scripts/kayit-al.ts TARAFINDAN ÜRETİLİR — elle düzenleme.
+ * Yeniden üretmek için: npm run banka
+ *
+ * Neden var: bazı telefonlarda cihazın konuşma motoru ya hiç ses vermiyor ya
+ * Türkçe harf seslerini bozuyor. Kayıtlı ses her cihazda birebir aynı ve
+ * nettir. Kaydı olmayan metinler otomatik olarak TTS'e düşer (hibrit).
+ *
+ * Dosyalar vite.config.js içindeki assetsInlineLimit sayesinde tek dosyalık
+ * pakette data-URI olarak gömülür: harici dosya gerekmez, file:// çalışır.
+ *
+ * KURAL: buraya giren her kayıt bir insan kulağıyla dinlenip onaylanmış
+ * olmalı. Doğrulanmamış ses, hiç sesten kötüdür.
+ */
+`;
+
+/** "harf-i-noktali.mp3" -> "HarfINoktali" (geçerli TS tanımlayıcısı) */
+function degisken(dosya: string): string {
+  return dosya
+    .replace(/\.mp3$/, "")
+    .split("-")
+    .filter(Boolean)
+    .map((p) => p[0].toUpperCase() + p.slice(1))
+    .join("");
+}
+
+/**
+ * Manifesti okur, dosyası gerçekten var olanları bankaya yazar.
+ * @returns bankaya giren kayıt sayısı
+ */
+export function bankaYaz(cikti: string = BANKA_DOSYASI): number {
+  if (!existsSync(MANIFEST)) {
+    throw new Error(
+      `${MANIFEST} yok. Önce kayıt üret: npm run kayit -- --deneme`,
+    );
+  }
+  const manifest = JSON.parse(readFileSync(MANIFEST, "utf8")) as Record<string, string>;
+  const girdiler = Object.entries(manifest)
+    .filter(([dosya]) => existsSync(join(SES_KLASORU, dosya)))
+    .sort((a, b) => a[1].localeCompare(b[1], "tr"));
+
+  // Aynı değişken adı iki dosyaya denk gelirse derleme bozulur.
+  const adlar = new Set<string>();
+  for (const [dosya] of girdiler) {
+    const ad = degisken(dosya);
+    if (adlar.has(ad)) throw new Error(`Değişken adı çakışması: ${ad} (${dosya})`);
+    adlar.add(ad);
+  }
+
+  const s: string[] = [BASLIK];
+  for (const [dosya] of girdiler) {
+    s.push(`import ${degisken(dosya)} from "${IMPORT_ONEK}/${dosya}";`);
+  }
+  s.push("", "const BANK: Record<string, string> = {");
+  for (const [dosya, metin] of girdiler) {
+    s.push(`  ${JSON.stringify(metin)}: ${degisken(dosya)},`);
+  }
+  s.push("};", "");
+  s.push(
+    "/** Bu metnin kaydı var mı? Varsa adresini döndürür. */",
+    "export function bankedAudio(text: string): string | null {",
+    "  return Object.prototype.hasOwnProperty.call(BANK, text) ? BANK[text] : null;",
+    "}",
+    "",
+    "/** Kayıtlı ses sayısı. */",
+    "export function bankedCount(): number {",
+    "  return Object.keys(BANK).length;",
+    "}",
+    "",
+    "/** Kaydı olan metinler. */",
+    "export function bankedTexts(): string[] {",
+    "  return Object.keys(BANK);",
+    "}",
+    "",
+    "/**",
+    " * Bir ses adresinin karşılığı olan metin (yoksa null). Test kurulumu bunu",
+    ' * kullanır: kayıtlı klip çalındığında da "ne söylendi" listesi dolsun ki',
+    " * testler sesin kaynağına (dosya mı TTS mi) bakmak zorunda kalmasın.",
+    " */",
+    "export function bankedTextFor(url: string | null | undefined): string | null {",
+    "  if (!url) return null;",
+    '  const norm = (u: string) => u.split("#")[0].split("?")[0];',
+    "  const target = norm(url);",
+    "  for (const [text, assetUrl] of Object.entries(BANK)) {",
+    "    const asset = norm(assetUrl);",
+    "    if (asset === target || target.endsWith(asset) || asset.endsWith(target)) return text;",
+    "  }",
+    "  return null;",
+    "}",
+    "",
+  );
+  writeFileSync(cikti, s.join("\n"));
+  return girdiler.length;
+}
diff --git a/scripts/kayit-mantik.ts b/scripts/kayit-mantik.ts
new file mode 100644
index 0000000..ab2f411
--- /dev/null
+++ b/scripts/kayit-mantik.ts
@@ -0,0 +1,87 @@
+/**
+ * Kayıt dosyalarının adlandırılması ve kaydedilecek metinlerin listesi.
+ *
+ * Ayrı modül olmasının nedeni test edilebilirlik: scripts/kayit-al.ts
+ * çalıştırılınca doğrudan main() çağırır; saf mantık burada durur ve
+ * scripts/__tests__/kayit-al.test.ts bunu denetler.
+ */
+import { GROUPS } from "../src/game/letters";
+
+export type Tur = "harf" | "kelime" | "cumle";
+
+export interface Kayit {
+  tur: Tur;
+  metin: string;
+  dosya: string;
+}
+
+/**
+ * Noktalı/işaretli Türkçe harfler ASCII'ye katlanınca noktasız ikizleriyle
+ * çakışır (Ü->u, Ö->o, Ç->c, Ş->s, İ->i). Aynı dosyaya iki farklı ses düşerse
+ * çocuk yanlış sesi duyar; bu yüzden ayrı ve okunaklı ad verilir. Windows
+ * dosya adlarında büyük/küçük harf ayrılmadığı için I/İ de burada ayrılır.
+ */
+const OZEL: Record<string, string> = {
+  İ: "i-noktali",
+  I: "i-noktasiz",
+  Ğ: "g-yumusak",
+  Ü: "u-iki-nokta",
+  Ö: "o-iki-nokta",
+  Ç: "c-cedilli",
+  Ş: "s-cedilli",
+};
+
+const ASCII: Record<string, string> = {
+  ç: "c", ğ: "g", ı: "i", ö: "o", ş: "s", ü: "u",
+  Ç: "c", Ğ: "g", İ: "i", I: "i", Ö: "o", Ş: "s", Ü: "u",
+};
+
+/** Dosya adı parçası: Türkçe harfler ASCII'ye, boşluk/işaret tireye. */
+export function slug(metin: string): string {
+  const duz = metin
+    .split("")
+    .map((c) => OZEL[c] ?? ASCII[c] ?? c)
+    .join("")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "");
+  return duz || "ses";
+}
+
+/**
+ * Kaydedilecek metinler — doğrudan uygulamanın kendi verisinden türetilir,
+ * elle liste tutulmaz. Böylece harf tablosu değişirse kayıtlar da izler.
+ */
+export function kayitlar(tur: Tur | "hepsi"): Kayit[] {
+  const out: Kayit[] = [];
+  for (const g of GROUPS) {
+    if (tur === "harf" || tur === "hepsi") {
+      for (const l of g.letters) {
+        out.push({ tur: "harf", metin: l.say, dosya: `harf-${slug(l.char)}.mp3` });
+      }
+    }
+    if (tur === "kelime" || tur === "hepsi") {
+      for (const l of g.letters) {
+        if (l.word) {
+          out.push({ tur: "kelime", metin: l.word, dosya: `kelime-${slug(l.word)}.mp3` });
+        }
+      }
+    }
+    if (tur === "cumle" || tur === "hepsi") {
+      (g.sentences ?? []).forEach((c: string, i: number) => {
+        out.push({ tur: "cumle", metin: c, dosya: `cumle-${g.id}-${i + 1}.mp3` });
+      });
+    }
+  }
+  // Aynı dosya adına iki farklı metin düşerse sessizce üstüne yazmayalım:
+  // bu, çocuğa yanlış harfin sesini dinletmenin dosya düzeyindeki hâlidir.
+  const gorulen = new Map<string, string>();
+  for (const k of out) {
+    const once = gorulen.get(k.dosya);
+    if (once && once !== k.metin) {
+      throw new Error(`Dosya adı çakışması: "${once}" ve "${k.metin}" -> ${k.dosya}`);
+    }
+    gorulen.set(k.dosya, k.metin);
+  }
+  return out;
+}

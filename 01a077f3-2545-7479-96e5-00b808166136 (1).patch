++
++        expect(results, `${group.name}/${name} tamamlanmadı`).toHaveLength(1);
++        expect(results[0].correct, `${group.name}/${name} doğru sayısı`).toBe(meta.rounds);
++        cleanup();
++      }
++    }, 120000);
++  }
++});

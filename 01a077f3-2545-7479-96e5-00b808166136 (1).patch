+/**
+ * Önceden kaydedilmiş sesler: konuşulacak metin -> ses dosyası.
+ *
+ * Neden var: bazı telefonlarda cihazın kendi konuşma motoru ya hiç ses vermiyor
+ * ya Türkçe sesi yok ya da harf seslerini bozuyor. Kayıtlı ses her cihazda
+ * birebir aynı ve nettir. Kaydı olmayan metinler otomatik olarak TTS'e düşer,
+ * yani liste eksikken de uygulama çalışır (hibrit).
+ *
+ * Dosyalar içe aktarılır; `vite.config.js` içindeki iç derleme
+ * `assetsInlineLimit: 100_000_000` kullandığı için tek dosyalık pakette bunlar
+ * data-URI olarak gömülür — harici dosya gerekmez, `file://`'de çalışır.
+ *
+ * ANAHTAR KURALI: anahtar, uygulamanın `say()`'e verdiği metnin BİREBİR aynı
+ * olmalı. Metni değiştirirsen buradaki anahtarı da değiştir.
+ *
+ * DOĞRULAMA KURALI: buraya giren her kayıt bir insan kulağıyla dinlenmiş
+ * olmalı. Tek harflik sesler bir ses modeli için belirsizdir ("e" harfini
+ * İngilizce harf adı gibi /iː/ okuyabiliyor) ve yanlış ses oyunu bozar.
+ */
+const BANK: Record<string, string> = {
+  // BİLEREK BOŞ.
+  //
+  // Burada üretilmiş (yapay) sesler vardı ve kaldırıldı: ses modeli tek
+  // harflik/hecelik Türkçe sesleri doğru okumuyordu ("e" harfini İngilizce
+  // harf adı gibi /iː/ diye okudu, çocuk "i" duydu) ve üretilen ses burada
+  // DUYULARAK denetlenemiyor. Doğrulanmamış ses, hiç sesten kötüdür.
+  //
+  // Buraya yalnızca bir insan kulağıyla dinlenip onaylanmış kayıt girer
+  // (ör. öğretmenin kendi kaydı ya da gerçek bir Türkçe TTS servisi çıktısı).
+  // Eklerken audioBank.test.ts içindeki kapsam kilidini de yükselt.
+};
+
+/** Bu metnin kaydı var mı? Varsa adresini döndürür. */
+export function bankedAudio(text: string): string | null {
+  return Object.prototype.hasOwnProperty.call(BANK, text) ? BANK[text] : null;
+}
+
+/** Kayıtlı ses sayısı (kapsamı görmek için). */
+export function bankedCount(): number {
+  return Object.keys(BANK).length;
+}
+
+/** Kaydı olan metinler. */
+export function bankedTexts(): string[] {
+  return Object.keys(BANK);
+}
+
+/**
+ * Bir ses adresinin karşılığı olan metin (yoksa null). Test kurulumu bunu
+ * kullanır: kayıtlı klip çalındığında da "ne söylendi" listesi dolsun ki
+ * testler sesin kaynağına (dosya mı TTS mi) bakmak zorunda kalmasın.
+ */
+export function bankedTextFor(url: string | null | undefined): string | null {
+  if (!url) return null;
+  const norm = (u: string) => u.split("#")[0].split("?")[0];
+  const target = norm(url);
+  for (const [text, assetUrl] of Object.entries(BANK)) {
+    const asset = norm(assetUrl);
+    // Derlemede adres data-URI'ye dönüşebiliyor; iki yönlü sonek eşleşmesi
+    // hem geliştirme adresini hem gömülü data-URI'yi yakalar.
+    if (asset === target || target.endsWith(asset) || asset.endsWith(target)) return text;
+  }
+  return null;
+}

+        fireEvent.click(card2!);
+        await tick(150);
+        expect(document.body.textContent ?? "").toContain(a.name);
+        fireEvent.click(screen.getByRole("button", { name: "Etkinlik listesine dön" }));
+        await tick(100);
+      }
+      cleanup();
+    }
+  }, 120000);

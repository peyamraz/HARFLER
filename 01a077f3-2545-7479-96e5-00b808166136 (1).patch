++  const tried = new Set<string>();
++  const cards = () => screen.queryAllByRole("button").filter((b) => b.className.includes("flip-scene"));
++  const closedIdx = () =>
++    cards().map((c, i) => ({ c, i })).filter(({ c }) => labelOf(c) === "Kapalı kart");
++  const read = (i: number) => {
++    const m = labelOf(cards()[i]).match(/^(.) harfi$/);

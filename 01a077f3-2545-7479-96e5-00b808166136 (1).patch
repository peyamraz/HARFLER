+import { act, cleanup, fireEvent, render } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import App from "../App";
+import { clearSpokenTexts, getSilentSpeakCount } from "../test/setup";
+
+/**
+ * Mobil kilit açma testi.
+ *
+ * iOS Safari ve Android Chrome speechSynthesis.speak()'i yalnızca bir kullanıcı
+ * hareketi sırasında kabul eder; aksi hâlde telefonda hiç ses çıkmaz. Uygulama
+ * ilk dokunuşta sessiz bir utterance konuşarak motoru açar.
+ *
+ * Ayrı dosyada tutuluyor: kilit modül düzeyinde tek seferlik açılır, başka bir
+ * test önce dokunursa bu test anlamsızlaşır.
+ */
+describe("mobil ses kilidi", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    localStorage.clear();
+    clearSpokenTexts();
+  });
+  afterEach(() => {
+    cleanup();
+    vi.useRealTimers();
+  });
+
+  it("kullanıcı hareketi olmadan motor açılmaz, ilk dokunuşta açılır", () => {
+    render(<App />);
+    act(() => {
+      vi.advanceTimersByTime(100);
+    });
+    expect(getSilentSpeakCount(), "hareket olmadan kilit açılmış").toBe(0);
+
+    fireEvent.pointerDown(document.body);
+
+    expect(getSilentSpeakCount(), "ilk dokunuş konuşma motorunu açmadı").toBe(1);
+  });
+});

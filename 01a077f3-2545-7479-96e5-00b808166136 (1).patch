++/**
++ * Türkçe ses kayıtlarını ElevenLabs ile üretir ve ses bankasına bağlar.
++ *
++ * NEDEN BU BETİK VAR: harf sesleri (a, e, ne, te...) tek harflik/hecelik
++ * metinlerdir ve sıradan bir ses modeli bunları yanlış okur ("e" harfini
++ * İngilizce harf adı gibi /iː/ okuyup çocuğa "i" dedirtir). Bu yüzden kayıt
++ * üretimini Türkçeyi resmî olarak destekleyen ve dil kodu verilebilen bir
++ * servis yapar; dosyaları da İNSAN KULAĞIYLA dinleyip onaylarsın.
++ *
++ * ANAHTAR GÜVENLİĞİ: API anahtarı YALNIZCA ortam değişkeninden okunur; hiçbir
++ * dosyaya yazılmaz, ekrana basılmaz, commit edilmez.
++ *
++ * KULLANIM (proje kökünde):
++ *   macOS/Linux : export ELEVENLABS_API_KEY="..."
++ *   Windows cmd : set ELEVENLABS_API_KEY=...
++ *   PowerShell  : $env:ELEVENLABS_API_KEY="..."
++ *
++ *   npm run kayit -- --deneme               # TEK ses üret, önce kulağınla dinle
++ *   npm run kayit -- --sesleri-listele      # sesleri gör, bayan bir ses seç
++ *   npm run kayit -- --ses <voice_id> --sadece harf
++ *   npm run kayit -- --ses <voice_id> --sadece hepsi
++ *   npm run banka                           # yalnızca src/audio/ -> audioBank.ts
++ */
++import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
++import { join } from "node:path";
++import { bankaYaz, MANIFEST, SES_KLASORU } from "./kayit-banka";
++import { kayitlar, slug, type Kayit, type Tur } from "./kayit-mantik";
++
++const API = "https://api.elevenlabs.io/v1/text-to-speech";
++const SESLER_API = "https://api.elevenlabs.io/v1/voices";
++/** Türkçe destekli ve dil kodu verilebilen model. */
++const VARSAYILAN_MODEL = "eleven_flash_v2_5";
++const VARSAYILAN_SES = "21m00Tcm4TlvDq8ikWAM";
++
++function anahtar(): string {
++  const k = process.env.ELEVENLABS_API_KEY;
++  if (!k) {
++    throw new Error(
++      [
++        "ELEVENLABS_API_KEY ortam değişkeni yok.",
++        "",
++        '  macOS/Linux : export ELEVENLABS_API_KEY="..."',
++        "  Windows cmd : set ELEVENLABS_API_KEY=...",
++        '  PowerShell  : $env:ELEVENLABS_API_KEY="..."',
++        "",
++        "Anahtarı sohbete YAZMA; kendi makinende ortam değişkeni olarak ver.",
++      ].join("\n"),
++    );
++  }
++  return k;
++}
++
++async function uret(k: string, ses: string, model: string, kayit: Kayit): Promise<void> {
++  const govde: Record<string, unknown> = {
++    text: kayit.metin,
++    model_id: model,
++    voice_settings: {
++      stability: 0.55,
++      similarity_boost: 0.8,
++      style: 0,
++      use_speaker_boost: true,
++    },
++  };
++  // Dil kodunu yalnızca kabul eden modellere gönder: eleven_multilingual_v2
++  // dili metinden kendi anlar, oraya göndermek uyarı üretir.
++  if (model !== "eleven_multilingual_v2") govde.language_code = "tr";
++
++  const yanit = await fetch(`${API}/${ses}`, {
++    method: "POST",
++    headers: { "xi-api-key": k, "Content-Type": "application/json", Accept: "audio/mpeg" },
++    body: JSON.stringify(govde),
++  });
++  if (!yanit.ok) {
++    const metin = await yanit.text().catch(() => "");
++    throw new Error(`"${kayit.metin}" üretilemedi (HTTP ${yanit.status}): ${metin.slice(0, 300)}`);
++  }
++  const bayt = Buffer.from(await yanit.arrayBuffer());
++  if (bayt.length < 500) {
++    throw new Error(`"${kayit.metin}" için boş/bozuk ses döndü (${bayt.length} bayt)`);
++  }
++  writeFileSync(join(SES_KLASORU, kayit.dosya), bayt);
++}
++
++async function sesleriListele(k: string): Promise<void> {
++  const yanit = await fetch(SESLER_API, { headers: { "xi-api-key": k } });
++  if (!yanit.ok) throw new Error(`Ses listesi alınamadı (HTTP ${yanit.status})`);
++  const veri = (await yanit.json()) as {
++    voices?: { voice_id: string; name: string; labels?: Record<string, string> }[];
++  };
++  console.log("\nvoice_id                            ad                       etiketler");
++  for (const v of veri.voices ?? []) {
++    const etiket = Object.entries(v.labels ?? {})
++      .map(([a, b]) => `${a}=${b}`)
++      .join(" ");
++    console.log(`${v.voice_id.padEnd(36)}${(v.name ?? "").slice(0, 24).padEnd(25)}${etiket}`);
++  }
++  console.log("\nBayan bir ses seç ve --ses <voice_id> ile kullan.\n");
++}
++
++async function main(): Promise<void> {
++  const arg = process.argv.slice(2);
++  const deger = (ad: string, yok: string) => {
++    const i = arg.indexOf(ad);
++    return i >= 0 && arg[i + 1] ? arg[i + 1] : yok;
++  };
++  const varMi = (ad: string) => arg.includes(ad);
++
++  if (varMi("--banka")) {
++    const n = bankaYaz();
++    console.log(`audioBank.ts yeniden yazıldı: ${n} kayıt.`);
++    console.log("Dinleyip doğrula: npm run dev");
++    console.log("Kapsam kilidini güncelle: src/game/__tests__/audioBank.test.ts");
++    return;
++  }
++
++  const k = anahtar();
++  if (varMi("--sesleri-listele")) return sesleriListele(k);
++
++  const ses = deger("--ses", VARSAYILAN_SES);
++  const model = deger("--model", VARSAYILAN_MODEL);
++  const sadece = deger("--sadece", "harf") as Tur | "hepsi";
++  const deneme = varMi("--deneme");
++  const atla = !varMi("--yeniden");
++
++  mkdirSync(SES_KLASORU, { recursive: true });
++  const liste: Kayit[] = deneme
++    ? [{ tur: "harf", metin: "e", dosya: `harf-${slug("E")}.mp3` }]
++    : kayitlar(sadece);
++
++  const manifest: Record<string, string> = existsSync(MANIFEST)
++    ? (JSON.parse(readFileSync(MANIFEST, "utf8")) as Record<string, string>)
++    : {};
++
++  console.log(`\nSes: ${ses}\nModel: ${model}  Dil: tr`);
++  console.log(`${liste.length} kayıt üretilecek.\n`);
++
++  let yapildi = 0;
++  for (const kayit of liste) {
++    const yol = join(SES_KLASORU, kayit.dosya);
++    if (atla && existsSync(yol)) {
++      manifest[kayit.dosya] = kayit.metin;
++      console.log(`= ${kayit.dosya}  (zaten var; --yeniden ile üzerine yaz)`);
++      continue;
++    }
++    await uret(k, ses, model, kayit);
++    manifest[kayit.dosya] = kayit.metin;
++    yapildi += 1;
++    console.log(`+ ${kayit.dosya}   "${kayit.metin}"`);
++  }
++
++  writeFileSync(MANIFEST, JSON.stringify(manifest, null, 2) + "\n");
++  const n = bankaYaz();
++  console.log(`\n${yapildi} yeni kayıt üretildi. Bankada toplam ${n} metin.`);
++  console.log("\nŞİMDİ DİNLE — doğrulanmamış ses yayına girmemeli:");
++  console.log("  npm run dev    (harf kutularına bas; özellikle a / e / i / ı)");
++  console.log("Yanlış olan dosyayı sil, sonra: npm run banka");
++  console.log("Kapsam kilidini güncelle: src/game/__tests__/audioBank.test.ts\n");
++}
++
++main().catch((e: unknown) => {
++  console.error(`\nHATA: ${e instanceof Error ? e.message : String(e)}\n`);
++  process.exit(1);
++});
